rules_version = '2';

// Règles de sécurité de la base Firestore (à coller dans la console Firebase,
// onglet Firestore Database > Règles).
// Chaque utilisateur ne peut lire et écrire QUE son propre document users/<son uid>.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
